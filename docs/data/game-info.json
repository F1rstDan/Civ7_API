{
  "category": "GameInfo",
  "description": "游戏数据表访问的全局对象。包含 150+ 个数据表，存储游戏内所有定义数据（单位、建筑、文明、领袖、资源等）。从不通过 import 引入，引擎直接注入。",
  "accessMethods": {
    "lookup": {
      "description": "通过哈希值或类型字符串查找单条记录。最常用的方法。",
      "params": "hashOrType (int|string)",
      "returns": "单条记录对象或 null"
    },
    "find": {
      "description": "按条件查找单条记录。",
      "params": "predicate (function)",
      "returns": "单条记录对象或 undefined"
    },
    "filter": {
      "description": "按条件过滤多条记录。",
      "params": "predicate (function)",
      "returns": "记录数组"
    },
    "forEach": {
      "description": "遍历所有记录执行回调。",
      "params": "callback (function)",
      "returns": "void"
    },
    "count": {
      "description": "返回记录总数。",
      "params": "",
      "returns": "int"
    }
  },
  "tables": [
