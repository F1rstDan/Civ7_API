{
  "category": "Configuration",
  "description": "游戏配置访问的全局对象。分为三个子配置：Game（游戏规则设置）、User（用户偏好设置）、Player（玩家槽位配置）。从不通过 import 引入，引擎直接注入。",
  "methods": [
    {
      "name": "getGame",
      "type": "method",
      "description": "获取游戏配置对象。包含游戏规则、模式、时代等全局设置。",
      "detailedNotes": "返回一个 GameConfiguration 对象，包含大量布尔和数值属性用于判断游戏模式。常用属性包括：isAnyMultiplayer、isHotseat、isNetworkMultiplayer、isNoTeams、isNoCivilizationUnlocks、previousAgeCount、campaignStartAgeType、skipStartButton 等。还支持 getValue(key) 方法读取自定义游戏设置。",
      "params": [],
      "returns": {
        "type": "GameConfiguration",
        "description": "游戏配置对象，包含 isAnyMultiplayer、previousAgeCount、getValue() 等属性和方法"
      },
      "edgeCases": "在非游戏界面（如主菜单）调用可能返回空对象或默认值。",
      "examples": [
        {
          "title": "判断是否为多人游戏",
          "code": "const gameConfig = Configuration.getGame();\nif (gameConfig.isAnyMultiplayer) {\n  console.log('多人游戏模式');\n}",
          "sourceFile": "modules/base-standard/ui/tutorial/tutorial-manager.js",
          "sourceLine": 24
        },
        {
          "title": "读取自定义游戏设置",
          "code": "const noCivUnlocks = Configuration.getGame().getValue('NoCivilizationUnlocks');\nif (noCivUnlocks === true) {\n  // 跳过文明解锁逻辑\n}",
          "sourceFile": "modules/core/ui-next/screens/unlocks/civ-unlocks-model.js",
          "sourceLine": 5
        },
        {
          "title": "获取已游玩时代数",
          "code": "const ageCount = Configuration.getGame().previousAgeCount;\nif (ageCount == 0) {\n  // 首次游戏\n}",
          "sourceFile": "modules/age-exploration/ui/tutorial/tutorial-items-exploration.js",
          "sourceLine": 88
        }
      ],
      "relatedAPIs": [
        "Configuration.getUser",
        "Configuration.getPlayer",
        "Game.age"
      ],
      "sourceFiles": [
