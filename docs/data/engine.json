      "type": "method",
      "description": "创建一个 JS 数据绑定模型，供 UI 模板系统使用。",
      "detailedNotes": "将一个 JS 对象注册为命名模型。通常在 whenReady 回调中调用。",
      "params": [
        {
          "name": "name",
          "type": "string",
          "description": "模型名称（如 'g_UnitPromotion'）",
          "required": true
        },
        {
          "name": "model",
          "type": "object",
          "description": "模型数据对象",
          "required": true
        }
      ],
      "returns": {
        "type": "void",
        "description": ""
      },
      "examples": [
        {
          "title": "注册数据绑定模型",
          "code": "engine.whenReady.then(() => {\n  engine.createJSModel('g_TutorialInspector', TutorialData);\n  TutorialData.updateCallback = () => engine.updateWholeModel(TutorialData);\n});",
