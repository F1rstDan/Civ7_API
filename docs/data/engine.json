{
  "category": "Engine",
  "description": "引擎核心对象。提供事件系统、数据绑定、引擎就绪检测等功能。从不通过 import 引入，引擎直接注入。",
  "methods": [
    {
      "name": "on",
      "type": "method",
      "description": "注册引擎事件监听器。这是 Mod 开发中最核心的 API 之一。",
      "detailedNotes": "用于监听游戏引擎发出的各种事件。第三个参数 context 用于绑定 this 上下文，方便后续用 off 移除。",
      "params": [
        {
          "name": "eventName",
          "type": "string",
          "description": "事件名称（如 'CityAddedToMap'）",
          "required": true
        },
        {
          "name": "callback",
          "type": "function",
          "description": "事件回调函数，接收事件数据对象",
          "required": true
        },
        {
          "name": "context",
          "type": "object",
          "description": "可选的 this 上下文绑定",
          "required": false
        }
      ],
      "returns": {
        "type": "void",
        "description": ""
      },
      "examples": [
        {
          "title": "监听城市添加事件",
          "code": "engine.on('CityAddedToMap', (data) => {\n  console.log('城市添加到地图', data);\n}, this);",
          "sourceFile": "modules/base-standard/ui/unit-combat-preview/panel-unit-combat-preview.js",
          "sourceLine": 64
        },
        {
          "title": "在引擎就绪后注册事件",
          "code": "engine.whenReady.then(() => {\n  engine.on('UnitMovementPointsChanged', (data) => {\n    if (data.unit.owner == GameContext.localPlayerID) {\n      engine.trigger('LocalPlayerUnitMovementPointsChanged', data);\n    }\n  });\n});",
          "sourceFile": "modules/age-antiquity/ui/tutorial/tutorial-items-antiquity.js",
          "sourceLine": 45
        }
      ],
      "relatedAPIs": [
        "engine.off",
        "engine.trigger",
        "engine.whenReady"
      ],
      "sourceFiles": [
        {
          "file": "modules/base-standard/ui/unit-combat-preview/panel-unit-combat-preview.js",
          "line": 64,
          "role": "usage_example"
        },
        {
          "file": "modules/age-antiquity/ui/tutorial/tutorial-items-antiquity.js",
          "line": 45,
          "role": "usage_example"
        },
        {
          "file": "modules/base-standard/maps/continents.js",
          "line": 197,
          "role": "usage_example"
        }
      ],
      "status": "inferred"
    },
    {
      "name": "off",
      "type": "method",
      "description": "移除引擎事件监听器。必须传入与 on 相同的参数才能正确匹配移除。",
      "detailedNotes": "通常在组件的 onDetach 或清理函数中调用，防止内存泄漏。",
      "params": [
        {
          "name": "eventName",
          "type": "string",
          "description": "事件名称",
          "required": true
        },
        {
          "name": "callback",
          "type": "function",
          "description": "之前注册的回调函数",
          "required": true
        },
        {
          "name": "context",
          "type": "object",
          "description": "可选的 this 上下文",
          "required": false
        }
      ],
      "returns": {
        "type": "void",
        "description": ""
      },
      "examples": [
        {
          "title": "在组件卸载时移除监听器",
          "code": "onDetach() {\n  engine.off('UnitSelectionChanged', this.onUnitSelectionChanged, this);\n  engine.off('UnitRemovedFromMap', this.onUnitRemovedFromMap, this);\n}",
          "sourceFile": "modules/base-standard/ui/unit-combat-preview/panel-unit-combat-preview.js",
          "sourceLine": 76
        }
      ],
      "relatedAPIs": [
        "engine.on"
      ],
      "sourceFiles": [
        {
          "file": "modules/base-standard/ui/unit-combat-preview/panel-unit-combat-preview.js",
          "line": 76,
          "role": "usage_example"
        }
      ],
      "status": "inferred"
    },
    {
      "name": "trigger",
      "type": "method",
      "description": "手动触发一个引擎事件。可用于自定义事件通信。",
      "detailedNotes": "触发的事件会被所有通过 engine.on 注册的监听器接收。",
      "params": [
        {
          "name": "eventName",
          "type": "string",
          "description": "要触发的事件名称",
          "required": true
        },
        {
          "name": "data",
          "type": "any",
          "description": "事件数据（可选）",
          "required": false
        }
      ],
      "returns": {
        "type": "void",
        "description": ""
      },
      "examples": [
        {
          "title": "触发自定义事件",
          "code": "engine.trigger('TutorialBegin');\nengine.trigger('open-civilopedia', searchTerm);",
          "sourceFile": "modules/base-standard/ui/tutorial/tutorial-inspector.js",
          "sourceLine": 24
