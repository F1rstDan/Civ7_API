        {
          "name": "args",
          "type": "any",
          "description": "方法参数",
          "required": false
        }
      ],
      "returns": {
        "type": "any",
        "description": "引擎方法的返回值"
      },
      "examples": [
        {
          "title": "向引擎传递地图初始化数据",
          "code": "engine.call('SetMapInitData', initParams);",
